global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:

  - job_name: "mariadb-replica"
    static_configs:
      - targets:
        - 10.202.49.107:9104
        - 10.202.49.114:9104


  - job_name: 'pve'
    metrics_path: /pve

    params:
      cluster: ['1']
      node: ['1']

    static_configs:
      - targets:
          - 10.202.49.203 

    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target

      - source_labels: [__param_target]
        target_label: instance

      - target_label: __address__
        replacement: 10.202.49.56:9221 

  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "blackbox"
    metrics_path: /probe
    params:
      module: [http_2xx]

    static_configs:
      - targets:
        - https://wordpress.scar

    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target

      - source_labels: [__param_target]
        target_label: instance

      - target_label: __address__
        replacement: localhost:9115

  - job_name: "node"
    static_configs:
      - targets:
{% for group in ['db_servers', 'wordpress', 'monitoring'] %}
{% for host in groups[group] | default([]) %}
        - "{{ hostvars[host]['ansible_host'] }}:9100"
{% endfor %}
{% endfor %}